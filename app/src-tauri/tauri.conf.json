{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misima Hybrid Player",
  "version": "0.1.0",
  "identifier": "com.misima.hybridplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Misima Hybrid Player",
        "width": 750,
        "height": 1030,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "focus": true,
        "additionalBrowserArgs": "--force-device-scale-factor=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "deb", "rpm", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
