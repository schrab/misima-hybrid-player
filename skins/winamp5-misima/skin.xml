<?xml version="1.0" encoding="UTF-8"?>
<!-- Winamp 5 freeform modern skin (simplified skeleton). True modern skins use .wal. -->
<WinampAbstractionLayer version="5.57">
  <skininfo>
    <version>1.0</version>
    <name>Misima Hybrid</name>
    <comment>Freeform skin derived from Misima UI sketch — spectrum / EQ / playlist</comment>
    <author>Misima</author>
    <email></email>
    <homepage></homepage>
  </skininfo>

  <include file="xml/player-elements.xml"/>
  <include file="xml/player-normal.xml"/>

  <groupdefs>
    <groupdef name="player.background" w="600" h="420">
      <layer
        id="player.bg"
        image="player.bg"
        x="0" y="0"
        sysregion="1"
      />
    </groupdef>
    <groupdef name="player.display" w="520" h="180">
      <vis
        id="main.vis"
        x="40" y="70"
        w="500" h="140"
        framerate="30"
        bandmode="1"
        peakmode="1"
        oscstyle="1"
        spectrummode="1"
      />
      <text
        id="main.songtitle"
        display="songtitle"
        x="50" y="40"
        w="420" h="14"
        fontsize="10"
        color="0,255,181"
        ticker="1"
      />
    </groupdef>
    <groupdef name="player.controls" w="600" h="48">
      <button
        id="previous"
        action="PREV"
        x="40" y="360"
        image="cbutton.prev"
        tooltip="Previous"
      />
      <button
        id="play"
        action="PLAY"
        x="72" y="360"
        image="cbutton.play"
        tooltip="Play"
      />
      <button
        id="pause"
        action="PAUSE"
        x="104" y="360"
        image="cbutton.pause"
        tooltip="Pause"
      />
      <button
        id="stop"
        action="STOP"
        x="136" y="360"
        image="cbutton.stop"
        tooltip="Stop"
      />
      <button
        id="next"
        action="NEXT"
        x="168" y="360"
        image="cbutton.next"
        tooltip="Next"
      />
      <hslider
        id="volume"
        action="volume"
        x="280" y="368"
        w="120" h="12"
        thumb="volume.thumb"
        bar="volume.bar"
        barwidth="120"
        barheight="12"
        min="0" max="128"
      />
    </groupdef>
  </groupdefs>

  <elements>
    <bitmap id="player.bg" file="png/player_bg.png"/>
    <bitmap id="cbutton.prev" file="png/cbutton_prev.png"/>
    <bitmap id="cbutton.play" file="png/cbutton_play.png"/>
    <bitmap id="cbutton.pause" file="png/cbutton_pause.png"/>
    <bitmap id="cbutton.stop" file="png/cbutton_stop.png"/>
    <bitmap id="cbutton.next" file="png/cbutton_next.png"/>
    <bitmap id="volume.thumb" file="png/volume_thumb.png"/>
    <bitmap id="volume.bar" file="png/volume_bar.png"/>
    <bitmap id="eq.bg" file="png/eq_bg.png"/>
    <bitmap id="pl.bg" file="png/playlist_bg.png"/>
  </elements>

  <containers>
    <container name="Main" default_x="0" default_y="0" default_visible="1">
      <layout id="normal" background="player.background" w="600" h="420">
        <group id="main.display" x="0" y="0" w="600" h="350"/>
        <group id="main.controls" x="0" y="0" w="600" h="420"/>
      </layout>
    </container>
    <container name="Equalizer" default_x="0" default_y="430" default_visible="1">
      <layout id="normal" background="eq.bg" w="600" h="240" />
    </container>
    <container name="Playlist" default_x="620" default_y="0" default_visible="1">
      <layout id="normal" background="pl.bg" w="480" h="520"/>
    </container>
  </containers>
</WinampAbstractionLayer>
